# --- Synapse Integration Configuration ---

# Dograh API (Cloud Platform)
DOGRAH_API_URL=https://api.dograh.com
DOGRAH_API_KEY=your_dograh_api_key_here
AGENT_UUID=your_agent_uuid_here

# Cloudflare Tunnel Configuration
BACKEND_API_ENDPOINT=https://your-ngrok-url.ngrok-free.app
BRIDGE_PUBLIC_URL=https://your-tunnel-url.trycloudflare.com
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token

# EspoCRM (Internal communication)
ESPO_URL=http://espocrm
ESPO_API_KEY=your_espo_api_key_here

# Local Storage
TRANSCRIPT_DIR=/app/transcripts
RETRY_STORE=/app/retries.json

# Twilio (Optional: for legacy telephony fallback)
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
